s://api.github.com/users/request/received_events","type":"Organization","user_view_type":"public","site_admin":false},"network_count":3136,"subscribers_count":413},"commits":[],"issues":[{"url":"https://api.github.com/repos/request/request/issues/3766","repository_url":"https://api.github.com/repos/request/request","labels_url":"https://api.github.com/repos/request/request/issues/3766/labels{/name}","comments_url":"https://api.github.com/repos/request/request/issues/3766/comments","events_url":"https://api.github.com/repos/request/request/issues/3766/events","html_url":"https://github.com/request/request/pull/3766","id":5519319606,"node_id":"PR_kwDOABOVr88AAAABEUwEsA","number":3766,"title":"Do not throw synchronously when request() is given a callback","user":{"login":"dyk1454683243-sudo","id":244863912,"node_id":"U_kgDODphTqA","avatar_url":"https://avatars.githubusercontent.com/u/244863912?v=4","gravatar_id":"","url":"https://api.github.com/users/dyk1454683243-sudo","html_url":"https://github.com/dyk1454683243-sudo","followers_url":"https://api.github.com/users/dyk1454683243-sudo/followers","following_url":"https://api.github.com/users/dyk1454683243-sudo/following{/other_user}","gists_url":"https://api.github.com/users/dyk1454683243-sudo/gists{/gist_id}","starred_url":"https://api.github.com/users/dyk1454683243-sudo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dyk1454683243-sudo/subscriptions","organizations_url":"https://api.github.com/users/dyk1454683243-sudo/orgs","repos_url":"https://api.github.com/users/dyk1454683243-sudo/repos","events_url":"https://api.github.com/users/dyk1454683243-sudo/events{/privacy}","received_events_url":"https://api.github.com/users/dyk1454683243-sudo/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-09-20T17:19:53Z","updated_at":"2026-09-23T08:13:32Z","closed_at":"2026-09-23T08:13:32Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/request/request/pulls/3766","html_url":"https://github.com/request/request/pull/3766","diff_url":"https://github.com/request/request/pull/3766.diff","patch_url":"https://github.com/request/request/pull/3766.patch","merged_at":null},"body":"## PR Checklist:\n- [x] I have run `npm test` locally. Lint and all tests touched by this change pass. Remaining failures are pre-existing on master under Node 22 (see notes).\n- [x] I have added/updated tests for any new behavior.\n- [x] If this is a significant change, an issue has already been created where the problem / solution was discussed: https://github.com/request/request/issues/2109\n\n## PR Description\n\nFixes #2109.\n\nAs discussed in #1429 / #2109, `request(options, callback)` should never throw synchronously. Immediately detectable errors (including HEAD requests with a body) must be delivered through the callback so callers who only handle `function (err, res, body)` actually see them.\n\n**Change:** wrap validation and `Request` construction in `request()`. When a callback is present, catch those errors and invoke the callback asynchronously via `setImmediate`/`process.nextTick`. When no callback is provided, rethrow so existing throw / EventEmitter `error` semantics are unchanged.\n\n**Tests:**\n- HEAD + body with a positional callback (the #2109 / #1429 case)\n- `request.head(..., callback)`\n- HEAD + body via `options.callback`\n- `request(undefined, callback)`\n- Existing no-callback HEAD + body cases still throw\n- `request.defaults` custom handler HEAD + body now receives the error in the callback\n\nRelated: #1429 (introduced the HEAD+body throw).\n\nFork PR: https://github.com/dyk1454683243-sudo/request/pull/1\n\n### Test notes (Node v22.14.0)\n\n- `standard` lint: pass\n- `tests/test-errors.js`: 27/27 (includes new #2109 cases)\n- `tests/test-defaults.js`: 57/57\n- `npm run test-ci`: 1540/1557 \u2014 same failures on unmodified master:\n  - `test-form-data.js` 43/45 (multipart + basic auth \u2192 400)\n  - `test-https.js` 10/20 (`CERT_HAS_EXPIRED` on bundled test certs)\n  - `test-timeout.js` 28/29 (connect-timeout `connect` flag)\n  - `test-tunnel.js` crashes (`ERR_SSL_CA_MD_TOO_WEAK` on old certs)","closed_by":{"login":"dyk1454683243-sudo","id":244863912,"node_id":"U_kgDODphTqA","avatar_url":"https://avatars.githubusercontent.com/u/244863912?v=4","gravatar_id":"","url":"https://api.github.com/users/dyk1454683243-sudo","html_url":"https://github.com/dyk1454683243-sudo","followers_url":"https://api.github.com/users/dyk1454683243-sudo/followers","following_url":"https://api.github.com/users/dyk1454683243-sudo/following{/other_user}","gists_url":"https://api.github.com/users/dyk1454683243-sudo/gists{/gist_id}","starred_url":"https://api.github.com/users/dyk1454683243-sudo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dyk1454683243-sudo/subscriptions","organizations_url":"https://api.github.com/users/dyk1454683243-sudo/orgs","repos_url":"https://api.github.com/users/dyk1454683243-sudo/repos","events_url":"https://api.github.com/users/dyk1454683243-sudo/events{/privacy}","received_events_url":"https://api.github.com/users/dyk1454683243-sudo/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/request/request/issues/3766/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/request/request/issues/3766/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/request/request/issues/3763","repository_url":"https://api.github.com/repos/request/request","labels_url":"https://api.github.com/repos/request/request/issues/3763/labels{/name}","comments_url":"ht