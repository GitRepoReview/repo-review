# Copy to .env. All values optional in dev.
DJANGO_SECRET_KEY=change-me
# Dev only. In prod leave unset; DJANGO_SECRET_KEY is then required.
DJANGO_DEBUG=1
# Emergency escape only: raises GitHub rate limit from 60 to 5000 req/h.
GITHUB_TOKEN=
# Prod only (the image sets the two paths itself).
# Comma-separated hostnames Django may serve. Required when DJANGO_DEBUG is unset.
DJANGO_ALLOWED_HOSTS=localhost
# Directory of the SQLite file (DB and report cache). Image default: /data, mount a volume there.
# DJANGO_DATA_DIR=/data
# Built frontend served by WhiteNoise. Image default: /app/dist.
# DJANGO_FRONTEND_DIST=/app/dist
